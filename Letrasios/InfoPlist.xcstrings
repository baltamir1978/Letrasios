    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras listens to the music around you to recognize the song and show its lyrics. Audio is never recorded or stored."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras écoute la musique autour de vous pour reconnaître la chanson et afficher ses paroles. L'audio n'est ni enregistré ni conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras hört die Musik um dich herum, um den Song zu erkennen und seinen Text anzuzeigen. Audio wird weder aufgenommen noch gespeichert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Letras ascolta la musica intorno a te per riconoscere la canzone e mostrarne il testo. L'audio non viene registrato né salvato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Letras ouve a música à sua volta para reconhecer a canção e mostrar a letra. O áudio não é gravado nem guardado."
          }
        }
      }
    }
  },
  "version": "1.0"
}